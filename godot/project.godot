config_version=5

[application]
config/name="MiniKarts"
config/icon="res://icon.svg"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")

[autoload]
Network="*res://scripts/network.gd"
Sound="*res://scripts/sound.gd"
ToonStyle="*res://scripts/toon_style.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1152
window/size/window_height_override=648
window/stretch/mode="canvas_items"
window/handheld/orientation=0
window/stretch/aspect="expand"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
shading/overrides/force_vertex_shading=false

[physics]
common/physics_interpolation=true

[input]
jump={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":32)]}
shoot={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":70)]}
reverse={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":66)]}
accelerate={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":87),Object(InputEventKey,"physical_keycode":4194320)]}
brake={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":83),Object(InputEventKey,"physical_keycode":4194322)]}
steer_left={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":65),Object(InputEventKey,"physical_keycode":4194319)]}
steer_right={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":68),Object(InputEventKey,"physical_keycode":4194321)]}
handbrake={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":4194325)]}
reset={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":82)]}
restart_race={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":4194309)]}
