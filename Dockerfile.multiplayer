FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl unzip libfontconfig1 libx11-6 libxcursor1 libxinerama1 \
    libxi6 libxrandr2 libgl1 libasound2 libpulse0 libwayland-client0 \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /opt/godot
RUN --mount=type=secret,id=build_ca,target=/run/secrets/build_ca \
    if [ -f /run/secrets/build_ca ]; then export CURL_CA_BUNDLE=/run/secrets/build_ca; fi; \
    curl -fL --retry 3 https://github.com/godotengine/godot/releases/download/4.5.1-stable/Godot_v4.5.1-stable_linux.x86_64.zip -o godot.zip \
    && printf '%s  godot.zip\n' '5bccbed65a94b82c7c319fdb15719ee8113a6e503976cc54e16f1c61fe95f3d74e5e40b8449b5bb89ff7f424574c20af01a4f5ef08b389e4dc338b245185b0b9' | sha512sum -c - \
    && unzip godot.zip && chmod +x Godot_v4.5.1-stable_linux.x86_64 && rm godot.zip
ENV GODOT_BIN=/opt/godot/Godot_v4.5.1-stable_linux.x86_64 PORT=8080
RUN useradd --create-home --uid 10001 minikarts
WORKDIR /app
COPY --chown=minikarts:minikarts godot/ godot/
COPY --chown=minikarts:minikarts scripts/server.sh scripts/server.sh
USER minikarts
# Import once during the build; the 512 MB service must not launch the editor.
RUN bash scripts/server.sh --import-only
EXPOSE 8080
CMD ["bash", "scripts/server.sh", "--preimported"]
